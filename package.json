{
  "name": "crm-electron-app",
  "version": "0.0.30",
  "description": "App de Recomendações de Produtos",
  "author": "CRM Team Farmarcas <uelinton.martins@terceirizados.farmarcas.com.br>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "lint": "node -e \"console.log('Lint não configurado')\"",
    "test": "node --test"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "electron": "^31.0.0",
    "electron-builder": "^26.4.0",
    "minimatch": "^10.2.6",
    "yaml": "^2.9.0"
  },
  "build": {
    "appId": "br.com.farmarcas.crm-electron-app",
    "productName": "CRM Radar",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "icon": "assets/icon.ico",
      "artifactName": "CRM-Radar-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CRM Radar",
      "uninstallDisplayName": "CRM Radar",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "license": "LICENSE.txt"
    },
    "publish": {
      "provider": "github",
      "owner": "farmarcas",
      "repo": "crm-electron-app",
      "releaseType": "release"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns"
    },
    "linux": {
      "executableName": "CRM Radar",
      "target": [
        "deb",
        "rpm"
      ],
      "icon": "assets",
      "extraFiles": [
        {
          "from": "scripts/linux-install-autostart.sh",
          "to": "linux-install-autostart.sh"
        }
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "server/**/*",
      "docs/api/openapi.yaml",
      "package.json",
      "assets/**/*",
      "node_modules/electron-log/**/*",
      "node_modules/electron-updater/**/*",
      "!node_modules/swagger-ui-dist/{index.html,index.css,index.js,absolute-path.js,swagger-initializer.js,oauth2-redirect.html,oauth2-redirect.js,swagger-ui.js,swagger-ui-standalone-preset.js,favicon-16x16.png,favicon-32x32.png}",
      "!node_modules/swagger-ui-dist/swagger-ui-es-bundle*",
      "!node_modules/swagger-ui-dist/**/*.map",
      "!node_modules/swagger-ui-dist/log.*.txt",
      "!node_modules/swagger-ui-dist/swagger-ui-standalone-preset.js.LICENSE.txt",
      "!node_modules/@scarf/**"
    ]
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "swagger-ui-dist": "5.32.15"
  },
  "scarfSettings": {
    "enabled": false
  }
}
